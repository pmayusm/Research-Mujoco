<mujoco model="flywheel_test">
    <compiler meshdir="meshes"/>
    <asset>
        <mesh name="launcher" file="simple launcher mesh.stl"/>
    </asset>
    <default>
        <geom contype="1" conaffinity="1"/>
    </default>

    <option timestep="0.003"
            gravity="0 0 -9.81"
            iterations="50"
            solver="PGS"/>

    <worldbody>
        <body name="launcher" pos="0 0 10">
            <geom type="mesh" mesh="launcher" contype="0" conaffinity="0"/>
        </body>

        <light diffuse="5 5 5" pos="0 0 3" dir="0 0 -1"/>
		<!-- <geom type="plane" size="100 100 10" rgba=".9 0 0 1"/> -->

        <!-- Flywheel -->
       <body name="flywheel" pos="10 10 0.2">

            <joint name="flywheel_joint"
                type="hinge"
                axis="1 0 0"
                damping="0"/>

            <geom type="cylinder"
                size="20 10"
                density="100"
                friction="3 0.5 0.5"
                euler="0 90 0"
                rgba="0 0 1 1"/>

        </body>


        <body name="ball" pos="10 55 50">
            <freejoint/>

            <geom type="sphere"
                size="28"
                density="200"
                friction="1 0.5 0.5"
                solref="0.02 1"
                solimp="0.9 0.95 0.001" />
        </body>

    </worldbody>

    <actuator>

        <motor joint="flywheel_joint"
            gear="10000000000"
            ctrlrange="-1 1"/>

    </actuator>

</mujoco>